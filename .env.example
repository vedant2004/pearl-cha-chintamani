# Pearl Cha Chintamani - Environment Variables
# For production, set these as Sensitive Environment Variables in Vercel.

# Admin Authentication
# Set ADMIN_PASSWORD for plaintext, or ADMIN_PASSWORD_HASH for scrypt hash
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_PASSWORD_HASH=
ADMIN_EMAIL=admin@pearlchachintamani.com
ADMIN_JWT_SECRET=your_random_32_character_jwt_secret_key_here

# App Configuration
NEXT_PUBLIC_APP_NAME=Pearl Cha Chintamani
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Supabase Connection (Leave blank to use built-in storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
